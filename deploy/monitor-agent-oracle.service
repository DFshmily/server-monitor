[Unit]
Description=Server Monitor Agent (Oracle)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/ubuntu/server-monitor/agent
Environment=MONITOR_BACKEND_URL=http://127.0.0.1:8000
Environment=MONITOR_INTERVAL=2
Environment=MONITOR_SERVER_NAME=oracle
Environment=MONITOR_API_KEY=monitor-secret-key-2026
ExecStart=/home/ubuntu/server-monitor/agent/venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
