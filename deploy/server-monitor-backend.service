[Unit]
Description=Server Monitor Backend (FastAPI)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/server-monitor/backend
# 密钥等敏感环境变量放 /etc/default/server-monitor（root 可读，不进仓库）
EnvironmentFile=/etc/default/server-monitor
Environment=MONITOR_HOST=127.0.0.1
Environment=MONITOR_PORT=8000
ExecStart=/home/ubuntu/server-monitor/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
